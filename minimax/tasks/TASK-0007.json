{
  "task_id": "TASK-0007",
  "title": "部分退款按商品金额占比分摊运费，并限制累计退款不超过实付金额",
  "summary": "退款服务当前只退还商品金额，运费一律不退：部分退款时用户少收运费，整单退款时退款总额也不等于实付金额；多次退款之间还没有累计校验，历史数据里出现过累计退款超过实付的脏账。本次任务按 SPEC-003#3.2 实现运费按商品金额占比分摊、按 SPEC-003#3.4 实现可退余额上限与告警，并且不得改变既有计价、运费与退款行为。",
  "query_hints": [
    "部分退款 运费退款 按商品金额占比分摊 退还运费",
    "累计退款 上限 可退余额 实付金额 已退金额 截断 告警",
    "RefundService.quote_partial_refund shipping_refund_cents warnings",
    "money.share HALF_UP 取整 到分"
  ],
  "steps": [
    {
      "id": "S1",
      "label": "确认 SPEC-003#3.2 运费分摊口径与 SPEC-003#3.4 累计上限口径"
    },
    {
      "id": "S2",
      "label": "在 RefundService.quote_partial_refund 中实现运费按商品金额占比分摊"
    },
    {
      "id": "S3",
      "label": "实现累计退款上限：可退余额 = 实付 - 已退，超额截断并返回告警"
    },
    {
      "id": "S4",
      "label": "运行目标测试与回归测试，记录退出码与结论"
    }
  ],
  "target_tests": [
    "demo_project/tests/test_refund_shipping_allocation.py"
  ],
  "regression_tests": [
    "demo_project/tests/test_pricing.py",
    "demo_project/tests/test_shipping.py",
    "demo_project/tests/test_refund_existing.py"
  ],
  "required_sources": {
    "spec": [
      "SPEC-003#3.2",
      "SPEC-003#3.4"
    ],
    "code": [
      "demo_project/ordercore/refund.py::RefundService.quote_partial_refund",
      "demo_project/ordercore/money.py::share"
    ],
    "test": [
      "demo_project/tests/test_refund_shipping_allocation.py::test_partial_refund_allocates_shipping_by_goods_share",
      "demo_project/tests/test_refund_shipping_allocation.py::test_full_refund_returns_all_shipping",
      "demo_project/tests/test_refund_shipping_allocation.py::test_cumulative_refund_is_capped_by_paid_amount"
    ]
  },
  "required_markers": [
    {
      "text": "运费退款 = `money.share(订单运费, 退款商品金额, 商品金额合计)`"
    },
    {
      "text": "尾差归入分摊后金额最大的商品行",
      "variants": [
        "v2"
      ]
    }
  ]
}
