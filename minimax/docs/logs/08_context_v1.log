### `demo_project/ordercore/money.py`（31 行）

```
   1 | """金额计算工具：整个工程只允许通过这里做取整，避免各处舍入口径不一致。"""
   2 | 
   3 | from __future__ import annotations
   4 | 
   5 | from decimal import ROUND_HALF_UP, Decimal
   6 | 
   7 | _CENT = Decimal("1")
   8 | 
   9 | 
  10 | def share(amount_cents: int, numerator: int, denominator: int) -> int:
  11 |     """按 ``numerator / denominator`` 摊分 ``amount_cents``，四舍五入到分（HALF_UP）。
  12 | 
  13 |     这是 SPEC-003#3.2 与 SPEC-003#3.3 指定的唯一分摊口径：
  14 |     先做精确的十进制乘法/除法，再一次性取整，禁止用浮点数相加后再取整。
  15 |     """
  16 |     if denominator <= 0:
  17 |         raise ValueError("denominator must be positive")
  18 |     if numerator < 0:
  19 |         raise ValueError("numerator must not be negative")
  20 |     if amount_cents == 0 or numerator == 0:
  21 |         return 0
  22 |     exact = Decimal(amount_cents) * Decimal(numerator) / Decimal(denominator)
  23 |     return int(exact.quantize(_CENT, rounding=ROUND_HALF_UP))
  24 | 
  25 | 
  26 | def apply_rate(amount_cents: int, rate: Decimal) -> int:
  27 |     """按费率取整（会员折扣用），同样使用 HALF_UP。"""
  28 |     if amount_cents == 0:
  29 |         return 0
  30 |     exact = Decimal(amount_cents) * rate
  31 |     return int(exact.quantize(_CENT, rounding=ROUND_HALF_UP))
