# 复制为 minimax/.env.local 后按需修改；.env.local 已在 .gitignore 中，不会入库。
# 所有值都是占位示例，提交前请确认没有真实凭据。

# ---- 资料库：seekdb / OceanBase（MySQL 协议）----
# auto = 先连 seekdb，连不上如实降级到 SQLite；seekdb / sqlite 可强制指定
SDDCTX_DB=auto
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=sddctx

# ---- 任务状态：PowerContext ----
# auto = 探测 PowerContext，可用了就用它，否则降级到本地事件文件
SDDCTX_STATE=auto
POWERCONTEXT_API_URL=http://127.0.0.1:8848
# 留空表示由固定幂等键自动创建/找回 Scope
POWERCONTEXT_SCOPE_ID=

# ---- 代码修改：MiniMax ----
# 仅 codegen 子命令需要；验证样例（demo sample）不需要 Key
MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimaxi.com
# 模型名必须以 python -m sddctx models 的返回为准（本作品验证时用 MiniMax-M2.7）
MINIMAX_MODEL=MiniMax-M2.7

# ---- 其它 ----
# 运行产物目录（上下文包、测试日志、状态文件）
SDDCTX_HOME=
# 默认导入的规格版本
SDDCTX_SPEC_VARIANT=v1
